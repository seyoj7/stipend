# Local development template. In production, set these in your hosting provider.
# Never expose AGENT_PRIVATE_KEY or AGENT_RUN_TOKEN as NEXT_PUBLIC variables.
AGENT_PRIVATE_KEY=
AGENT_RUN_TOKEN=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Keep both addresses in sync. Defaults to the current Aevum deployment.
STIPEND_CONTRACT_ADDRESS=0xa05f94c4D521e69771Dd6bF75aafDE08d431812e
NEXT_PUBLIC_STIPEND_CONTRACT_ADDRESS=0xa05f94c4D521e69771Dd6bF75aafDE08d431812e
