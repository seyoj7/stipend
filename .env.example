# Copy to .env.local. Keep the real agent key only in .env.local.
AGENT_PRIVATE_KEY=0xreplace_with_a_64_character_private_key
AGENT_RUN_TOKEN=replace_with_a_long_random_token
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=replace_with_walletconnect_project_id

# Optional override; defaults to the Stipend address recorded by Ignition.
STIPEND_CONTRACT_ADDRESS=0x48AE961094A35c56a19CE93639179706441EC8f4
NEXT_PUBLIC_STIPEND_CONTRACT_ADDRESS=0x48AE961094A35c56a19CE93639179706441EC8f4
